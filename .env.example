# server/.env  (copy to server/.env, never commit real values)
PORT=5000
NODE_ENV=development
# MongoDB Atlas > Connect > Drivers > copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-media-search
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# client/.env
# VITE_API_URL=http://localhost:5000/api
# optional (server)
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=10
# client/.env (optional footer links)
# VITE_GITHUB_URL=https://github.com/<you>/smart-media-search
# VITE_CONTACT_EMAIL=you@example.com
